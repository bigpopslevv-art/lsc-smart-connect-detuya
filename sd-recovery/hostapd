#!/bin/sh
# De firmware kopieert dit bestand van de SD-kaart naar /tmp en start het als
#   /tmp/hostapd /etc/config/hostapd.conf -B
# (alleen in AP/pairing-modus). Wij misbruiken het als vroege boot-hook: het
# draait als root, voordat anyka_ipc start, en voert hack.sh van de kaart uit.
/bin/sh /mnt/hack.sh
