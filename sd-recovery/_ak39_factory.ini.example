; Rename to _ak39_factory.ini on the FAT32 SD card.
; This puts the camera in factory-test mode: it starts telnetd and the RTSP server
; (anyka_ipc then serves rtsp://<ip>:554/main_ch). Fill in your own wifi.
[wifi_station]
ssid=YOUR_WIFI_SSID
passphrase=YOUR_WIFI_PASSWORD
ip=192.168.1.240
netmask=255.255.255.0
gateway=

[aging_test]
aging_value=0
